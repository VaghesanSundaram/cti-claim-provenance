{
  "$defs": {
    "CandidateDocumentV4": {
      "additionalProperties": false,
      "description": "Neutral candidate-visible document with opaque identifiers.",
      "properties": {
        "available_by_utc": {
          "format": "date-time",
          "title": "Available By Utc",
          "type": "string"
        },
        "document_alias": {
          "pattern": "^doc-[0-9a-f]{12}$",
          "title": "Document Alias",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/CandidateEvidenceSpanV4"
          },
          "title": "Evidence",
          "type": "array"
        },
        "neutral_title": {
          "pattern": "^Evidence document [0-9]{2}$",
          "title": "Neutral Title",
          "type": "string"
        },
        "publisher_identity": {
          "minLength": 1,
          "title": "Publisher Identity",
          "type": "string"
        },
        "source_class": {
          "enum": [
            "government",
            "standards_body",
            "vendor"
          ],
          "title": "Source Class",
          "type": "string"
        },
        "state_label": {
          "pattern": "^State [0-9]{2}$",
          "title": "State Label",
          "type": "string"
        },
        "temporal_basis": {
          "enum": [
            "publisher_declared_version",
            "observed_retrieval",
            "publisher_timestamp_with_observation"
          ],
          "title": "Temporal Basis",
          "type": "string"
        }
      },
      "required": [
        "document_alias",
        "neutral_title",
        "state_label",
        "available_by_utc",
        "temporal_basis",
        "publisher_identity",
        "source_class",
        "evidence"
      ],
      "title": "CandidateDocumentV4",
      "type": "object"
    },
    "CandidateEvidenceSpanV4": {
      "additionalProperties": false,
      "description": "Opaque candidate-visible span identifier and authentic evidence text.",
      "properties": {
        "span_alias": {
          "pattern": "^span-[0-9a-f]{12}$",
          "title": "Span Alias",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "span_alias",
        "text"
      ],
      "title": "CandidateEvidenceSpanV4",
      "type": "object"
    },
    "CandidatePacketV4": {
      "additionalProperties": false,
      "description": "Candidate-visible clean packet separated from evaluator provenance.",
      "properties": {
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "cutoff_utc": {
          "format": "date-time",
          "title": "Cutoff Utc",
          "type": "string"
        },
        "documents": {
          "items": {
            "$ref": "#/$defs/CandidateDocumentV4"
          },
          "title": "Documents",
          "type": "array"
        },
        "packet_id": {
          "minLength": 1,
          "title": "Packet Id",
          "type": "string"
        },
        "packet_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Packet Sha256",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "packet_id",
        "case_id",
        "question",
        "cutoff_utc",
        "documents",
        "packet_sha256"
      ],
      "title": "CandidatePacketV4",
      "type": "object"
    },
    "EvaluatorDocumentBindingV4": {
      "additionalProperties": false,
      "description": "Evaluator-only mapping from an opaque alias to full provenance.",
      "properties": {
        "document_alias": {
          "pattern": "^doc-[0-9a-f]{12}$",
          "title": "Document Alias",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvaluatorEvidenceBindingV4"
          },
          "title": "Evidence",
          "type": "array"
        },
        "local_reference": {
          "minLength": 1,
          "title": "Local Reference",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "document_alias",
        "source_id",
        "source_sha256",
        "title",
        "url",
        "local_reference",
        "evidence"
      ],
      "title": "EvaluatorDocumentBindingV4",
      "type": "object"
    },
    "EvaluatorEvidenceBindingV4": {
      "additionalProperties": false,
      "description": "Evaluator-only binding from a span alias to provenance evidence.",
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "span_alias": {
          "pattern": "^span-[0-9a-f]{12}$",
          "title": "Span Alias",
          "type": "string"
        }
      },
      "required": [
        "span_alias",
        "evidence_id",
        "locator"
      ],
      "title": "EvaluatorEvidenceBindingV4",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Clean candidate packets regenerated from the corrected V6 corpus.",
  "properties": {
    "corpus_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Corpus Sha256",
      "type": "string"
    },
    "evaluator_bindings": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/EvaluatorDocumentBindingV4"
        },
        "type": "array"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Evaluator Bindings",
      "type": "object"
    },
    "index_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Index Sha256",
      "type": "string"
    },
    "packets": {
      "items": {
        "$ref": "#/$defs/CandidatePacketV4"
      },
      "title": "Packets",
      "type": "array"
    },
    "schema_version": {
      "const": "portfolio-diverse-packets-v6",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "corpus_sha256",
    "packets",
    "evaluator_bindings",
    "index_sha256"
  ],
  "title": "PacketIndexV6",
  "type": "object"
}
