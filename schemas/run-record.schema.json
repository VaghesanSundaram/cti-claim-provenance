{
  "additionalProperties": false,
  "description": "Non-secret, append-only summary for one scheduled experiment slot.",
  "properties": {
    "authority_policy_version": {
      "minLength": 1,
      "title": "Authority Policy Version",
      "type": "string"
    },
    "cached_input_tokens": {
      "minimum": 0,
      "title": "Cached Input Tokens",
      "type": "integer"
    },
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "case_seed": {
      "minimum": 0,
      "title": "Case Seed",
      "type": "integer"
    },
    "condition": {
      "enum": [
        "lexical_direct_answer",
        "lexical_citation_prompted",
        "lexical_claim_evidence_constrained",
        "claim_evidence_with_verifier"
      ],
      "title": "Condition",
      "type": "string"
    },
    "corpus_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Corpus Manifest Hash",
      "type": "string"
    },
    "dataset_version": {
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "deterministic_outcome": {
      "enum": [
        "graded",
        "unusable_slot",
        "not_graded",
        "not_applicable"
      ],
      "title": "Deterministic Outcome",
      "type": "string"
    },
    "error_category": {
      "enum": [
        "none",
        "local_safety_block",
        "provider_refusal",
        "transport",
        "timeout",
        "parse",
        "schema",
        "retrieval",
        "grader",
        "infrastructure"
      ],
      "title": "Error Category",
      "type": "string"
    },
    "estimated_cost_usd": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Estimated Cost Usd",
      "type": "string"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Id"
    },
    "model_snapshot_or_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Snapshot Or Version"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "parse_status": {
      "enum": [
        "valid",
        "invalid",
        "not_applicable"
      ],
      "title": "Parse Status",
      "type": "string"
    },
    "project_version": {
      "minLength": 1,
      "title": "Project Version",
      "type": "string"
    },
    "prompt_version": {
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "provider": {
      "enum": [
        "none",
        "openai",
        "anthropic",
        "google"
      ],
      "title": "Provider",
      "type": "string"
    },
    "provider_status": {
      "enum": [
        "not_called",
        "allowed",
        "refused",
        "additional_check",
        "blocked",
        "error"
      ],
      "title": "Provider Status",
      "type": "string"
    },
    "recorded_at_utc": {
      "format": "date-time",
      "title": "Recorded At Utc",
      "type": "string"
    },
    "retrieval_outcome": {
      "enum": [
        "success",
        "empty",
        "error",
        "not_applicable"
      ],
      "title": "Retrieval Outcome",
      "type": "string"
    },
    "retriever_version": {
      "minLength": 1,
      "title": "Retriever Version",
      "type": "string"
    },
    "retry_count": {
      "minimum": 0,
      "title": "Retry Count",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "security_outcome": {
      "enum": [
        "allowed",
        "refused",
        "additional_check",
        "blocked",
        "unknown",
        "not_applicable"
      ],
      "title": "Security Outcome",
      "type": "string"
    },
    "utility_outcome": {
      "enum": [
        "claims_emitted",
        "abstained",
        "empty",
        "unusable",
        "not_applicable"
      ],
      "title": "Utility Outcome",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "recorded_at_utc",
    "project_version",
    "dataset_version",
    "case_id",
    "case_seed",
    "condition",
    "provider",
    "model_id",
    "model_snapshot_or_version",
    "prompt_version",
    "retriever_version",
    "corpus_manifest_hash",
    "authority_policy_version",
    "input_tokens",
    "cached_input_tokens",
    "output_tokens",
    "latency_ms",
    "retry_count",
    "provider_status",
    "parse_status",
    "retrieval_outcome",
    "deterministic_outcome",
    "security_outcome",
    "utility_outcome",
    "error_category",
    "estimated_cost_usd"
  ],
  "title": "RunRecord",
  "type": "object"
}
