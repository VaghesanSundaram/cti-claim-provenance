{
  "$defs": {
    "ReviewVerdict": {
      "additionalProperties": false,
      "description": "A complete reviewer or adjudicator decision.",
      "properties": {
        "alternate_evidence_exists": {
          "title": "Alternate Evidence Exists",
          "type": "boolean"
        },
        "alternate_evidence_notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Alternate Evidence Notes"
        },
        "answerability": {
          "enum": [
            "answer",
            "abstain",
            "ambiguous"
          ],
          "title": "Answerability",
          "type": "string"
        },
        "authority": {
          "enum": [
            "acceptable",
            "unacceptable",
            "unclear"
          ],
          "title": "Authority",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "cutoff": {
          "enum": [
            "eligible",
            "ineligible",
            "unclear"
          ],
          "title": "Cutoff",
          "type": "string"
        },
        "evidence_support": {
          "enum": [
            "fully_supported",
            "partially_supported",
            "relevant_but_unsupported",
            "contradicts",
            "unclear"
          ],
          "title": "Evidence Support",
          "type": "string"
        },
        "factual_correctness": {
          "enum": [
            "correct",
            "incorrect",
            "ambiguous"
          ],
          "title": "Factual Correctness",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notes"
        },
        "question_quality": {
          "enum": [
            "clear",
            "needs_revision",
            "exclude"
          ],
          "title": "Question Quality",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        }
      },
      "required": [
        "factual_correctness",
        "evidence_support",
        "authority",
        "cutoff",
        "answerability",
        "alternate_evidence_exists",
        "alternate_evidence_notes",
        "question_quality",
        "confidence",
        "notes",
        "reason"
      ],
      "title": "ReviewVerdict",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One immutable reviewer decision; corrections append a superseding record.",
  "properties": {
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "case_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Case Sha256",
      "type": "string"
    },
    "decided_at_utc": {
      "format": "date-time",
      "title": "Decided At Utc",
      "type": "string"
    },
    "decision_id": {
      "minLength": 1,
      "title": "Decision Id",
      "type": "string"
    },
    "evidence_binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Binding Sha256",
      "type": "string"
    },
    "item_id": {
      "minLength": 1,
      "title": "Item Id",
      "type": "string"
    },
    "item_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Item Sha256",
      "type": "string"
    },
    "label_change_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Label Change Reason"
    },
    "label_changed": {
      "title": "Label Changed",
      "type": "boolean"
    },
    "original_label_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Original Label Sha256",
      "type": "string"
    },
    "packet_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Packet Sha256",
      "type": "string"
    },
    "reviewer_id": {
      "pattern": "^reviewer-[a-z0-9-]{3,32}$",
      "title": "Reviewer Id",
      "type": "string"
    },
    "schema_version": {
      "const": "review-decision-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "supersedes_decision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Supersedes Decision Id"
    },
    "verdict": {
      "$ref": "#/$defs/ReviewVerdict"
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "packet_sha256",
    "item_id",
    "item_sha256",
    "case_id",
    "case_sha256",
    "evidence_binding_sha256",
    "reviewer_id",
    "decided_at_utc",
    "supersedes_decision_id",
    "original_label_sha256",
    "verdict",
    "label_changed",
    "label_change_reason"
  ],
  "title": "ReviewDecision",
  "type": "object"
}
