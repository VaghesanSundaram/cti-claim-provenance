      "new_state_citations",
      "change",
      "change_citations"
    ],
    "oracle": ["change", "change_citations", "final_answer", "citations"]
  },
  "analysis": {
    "primary_outcome": "semantically_correct_final_answer",
    "failure_score": 0,
    "aggregation": "average trials within question-condition, questions within dependency cluster, then equally weight 19 clusters",
    "decomposition_effect": "0.5*((C-A)+(D-B))",
    "schema_effect": "0.5*((B-A)+(D-C))",
    "interaction": "(D-C)-(B-A)",
    "bootstrap_clusters": 10000,
    "bootstrap_seed": 20260901,
    "bootstrap_interval": [0.025, 0.975]
  },
  "failure_categories": [
