{
  "schema_version": "cti-temporal-experiment-v2",
  "experiment_version": "temporal-v2.0",
  "research_scope": "temporal answer construction from approved supplied state evidence",
  "source_artifacts": {
    "questions": "data/benchmark/questions.json",
    "packets": "data/benchmark/evidence-packets.json"
  },
  "factorial": {
    "case_slice": "temporal_comparison",
    "question_count": 24,
    "dependency_cluster_count": 19,
    "trials": 5,
    "conditions": {
      "A": {"method": "direct", "schema_enforced": false},
      "B": {"method": "direct", "schema_enforced": true},
      "C": {"method": "state_first", "schema_enforced": false},
      "D": {"method": "state_first", "schema_enforced": true}
    },
    "cell_count": 480
  },
  "oracle": {
    "case_ids": [
      "temporal-03",
      "temporal-04",
      "temporal-05",
      "temporal-18",
      "temporal-19",
      "temporal-20",
      "temporal-22",
      "temporal-24"
    ],
    "selection_rule": "Eight dependency-distinct cases chosen before v2 outputs to cover both splits, change and no-change outcomes, string, set, mapping, and mixed state shapes; v1 performance was not consulted.",
    "trials": 5,
    "schema_enforced": true,
    "cell_count": 40,
    "excluded_from_factorial_effects": true
  },
  "schedule": {
    "total_cells": 520,
    "condition_orders": ["ABCD", "BCDA", "CDAB", "DABC"],
    "order_rule": "Interleave dependency clusters within each trial; rotate condition order by question and trial; insert oracle cells within each trial.",
    "cell_id_fields": ["experiment_version", "case_id", "condition", "trial"],
