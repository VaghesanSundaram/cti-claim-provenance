{
  "$defs": {
    "ClaimQualifiers": {
      "additionalProperties": false,
      "description": "Frozen qualifier vocabulary used by the first benchmark version.",
      "properties": {
        "authority": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Authority"
        },
        "cvss_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cvss Version"
        },
        "ecosystem": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ecosystem"
        },
        "product": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Product"
        }
      },
      "required": [
        "authority",
        "cvss_version",
        "product",
        "ecosystem"
      ],
      "title": "ClaimQualifiers",
      "type": "object"
    },
    "ClaimSubject": {
      "additionalProperties": false,
      "description": "Typed claim subject.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "cve",
            "product",
            "advisory",
            "attack_object"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "ClaimSubject",
      "type": "object"
    },
    "JsonValue": {},
    "OriginalLabel": {
      "additionalProperties": false,
      "description": "The pre-review benchmark label, separate from later decisions.",
      "properties": {
        "abstention_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Abstention Reason"
        },
        "expected_answer": {
          "enum": [
            "answer",
            "abstain"
          ],
          "title": "Expected Answer",
          "type": "string"
        },
        "expected_claim": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewClaim"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "expected_answer",
        "abstention_reason",
        "expected_claim"
      ],
      "title": "OriginalLabel",
      "type": "object"
    },
    "ReviewClaim": {
      "additionalProperties": false,
      "description": "JSON-stable display form of one typed gold claim.",
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "datatype": {
          "enum": [
            "boolean",
            "string",
            "date",
            "decimal",
            "version_set",
            "identifier_set"
          ],
          "title": "Datatype",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "predicate": {
          "enum": [
            "cve.affected_versions",
            "directive.required_action",
            "cve.published_at",
            "cve.modified_at",
            "cve.cvss.score",
            "kev.is_member",
            "kev.date_added",
            "kev.due_date",
            "kev.ransomware_campaign_use",
            "nvd.cpe_applicability",
            "vendor.affected_versions",
            "vendor.fixed_versions",
            "vendor.recommended_action",
            "vendor.release_affected_versions",
            "vendor.security_release_versions",
            "vendor.cve_fixed_release",
            "attack.relationship_present",
            "attack.platforms",
            "source.temporal_change",
            "source.authority_divergence",
            "source.multi_source_synthesis"
          ],
          "title": "Predicate",
          "type": "string"
        },
        "qualifiers": {
          "$ref": "#/$defs/ClaimQualifiers"
        },
        "subject": {
          "$ref": "#/$defs/ClaimSubject"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "claim_id",
        "subject",
        "predicate",
        "value",
        "datatype",
        "qualifiers",
        "evidence_ids"
      ],
      "title": "ReviewClaim",
      "type": "object"
    },
    "ReviewEvidence": {
      "additionalProperties": false,
      "description": "Exact evidence plus bounded context and immutable source bindings.",
      "properties": {
        "authority_category": {
          "enum": [
            "primary",
            "acceptable_corroboration",
            "unacceptable",
            "synthetic_control"
          ],
          "title": "Authority Category",
          "type": "string"
        },
        "available_by_utc": {
          "format": "date-time",
          "title": "Available By Utc",
          "type": "string"
        },
        "context_after": {
          "title": "Context After",
          "type": "string"
        },
        "context_before": {
          "title": "Context Before",
          "type": "string"
        },
        "cutoff_eligibility": {
          "enum": [
            "eligible",
            "ineligible"
          ],
          "title": "Cutoff Eligibility",
          "type": "string"
        },
        "document_date_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Document Date Utc"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "exact_text": {
          "title": "Exact Text",
          "type": "string"
        },
        "field_path": {
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "local_reference": {
          "minLength": 1,
          "title": "Local Reference",
          "type": "string"
        },
        "normalized_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Normalized Text Sha256",
          "type": "string"
        },
        "raw_locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Locator"
        },
        "raw_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Snapshot Sha256",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_name": {
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "source_url": {
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "span_id": {
          "minLength": 1,
          "title": "Span Id",
          "type": "string"
        },
        "span_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Span Text Sha256",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "snapshot_id",
        "document_id",
        "span_id",
        "field_path",
        "exact_text",
        "context_before",
        "context_after",
        "raw_locator",
        "source_url",
        "local_reference",
        "source_name",
        "document_date_utc",
        "available_by_utc",
        "authority_category",
        "cutoff_eligibility",
        "raw_snapshot_sha256",
        "normalized_text_sha256",
        "span_text_sha256"
      ],
      "title": "ReviewEvidence",
      "type": "object"
    },
    "ReviewItem": {
      "additionalProperties": false,
      "description": "One complete, blinded human-review unit.",
      "properties": {
        "alternate_evidence": {
          "items": {
            "$ref": "#/$defs/ReviewEvidence"
          },
          "title": "Alternate Evidence",
          "type": "array"
        },
        "case_category": {
          "enum": [
            "answerable",
            "insufficient_evidence",
            "contradiction",
            "wrong_date",
            "weak_authority",
            "poison",
            "distractor"
          ],
          "title": "Case Category",
          "type": "string"
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "case_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Case Sha256",
          "type": "string"
        },
        "cutoff_utc": {
          "format": "date-time",
          "title": "Cutoff Utc",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ReviewEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Binding Sha256",
          "type": "string"
        },
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "item_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Item Sha256",
          "type": "string"
        },
        "original_label": {
          "$ref": "#/$defs/OriginalLabel"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "required_authority_policy_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Authority Policy Ids",
          "type": "array"
        },
        "scope_label": {
          "enum": [
            "Log4Shell plumbing-only",
            "portfolio-scale pilot development/validation"
          ],
          "title": "Scope Label",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ReviewSource"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "item_sha256",
        "case_id",
        "case_sha256",
        "question",
        "cutoff_utc",
        "case_category",
        "scope_label",
        "original_label",
        "required_authority_policy_ids",
        "sources",
        "evidence",
        "alternate_evidence",
        "evidence_binding_sha256"
      ],
      "title": "ReviewItem",
      "type": "object"
    },
    "ReviewSource": {
      "additionalProperties": false,
      "description": "One frozen source state visible to a reviewer.",
      "properties": {
        "available_by_basis": {
          "minLength": 1,
          "title": "Available By Basis",
          "type": "string"
        },
        "available_by_utc": {
          "format": "date-time",
          "title": "Available By Utc",
          "type": "string"
        },
        "canonical_url": {
          "minLength": 1,
          "title": "Canonical Url",
          "type": "string"
        },
        "local_reference": {
          "minLength": 1,
          "title": "Local Reference",
          "type": "string"
        },
        "modified_at_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Modified At Utc"
        },
        "normalized_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Normalized Text Sha256",
          "type": "string"
        },
        "published_at_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published At Utc"
        },
        "raw_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Snapshot Sha256",
          "type": "string"
        },
        "retrieved_at_utc": {
          "format": "date-time",
          "title": "Retrieved At Utc",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_class": {
          "enum": [
            "government",
            "standards_body",
            "vendor",
            "synthetic"
          ],
          "title": "Source Class",
          "type": "string"
        },
        "source_name": {
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "temporal_evidence_description": {
          "minLength": 1,
          "title": "Temporal Evidence Description",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        }
      },
      "required": [
        "snapshot_id",
        "source_name",
        "source_class",
        "title",
        "canonical_url",
        "local_reference",
        "published_at_utc",
        "modified_at_utc",
        "retrieved_at_utc",
        "available_by_utc",
        "available_by_basis",
        "temporal_evidence_description",
        "raw_snapshot_sha256",
        "normalized_text_sha256"
      ],
      "title": "ReviewSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned packet containing labels but no system result fields.",
  "properties": {
    "authority_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Authority Policy Sha256",
      "type": "string"
    },
    "benchmark_scope": {
      "enum": [
        "Log4Shell plumbing-only",
        "portfolio-scale pilot development/validation"
      ],
      "title": "Benchmark Scope",
      "type": "string"
    },
    "blinding_statement": {
      "const": "No model outputs, conditions, pass/fail fields, aggregates, or preferences.",
      "title": "Blinding Statement",
      "type": "string"
    },
    "case_file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Case File Sha256",
      "type": "string"
    },
    "created_at_utc": {
      "format": "date-time",
      "title": "Created At Utc",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ReviewItem"
      },
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "packet_id": {
      "minLength": 1,
      "title": "Packet Id",
      "type": "string"
    },
    "packet_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Packet Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "review-packet-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_license_or_terms": {
      "anyOf": [
        {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source License Or Terms"
    }
  },
  "required": [
    "schema_version",
    "packet_id",
    "packet_sha256",
    "created_at_utc",
    "benchmark_scope",
    "blinding_statement",
    "case_file_sha256",
    "authority_policy_sha256",
    "items"
  ],
  "title": "ReviewPacket",
  "type": "object"
}
