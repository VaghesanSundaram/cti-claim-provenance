{
  "additionalProperties": false,
  "description": "A terminal observation for a reserved attempt (never a retry decision).",
  "properties": {
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "attempt_index": {
      "maximum": 2,
      "minimum": 1,
      "title": "Attempt Index",
      "type": "integer"
    },
    "cached_input_tokens": {
      "minimum": 0,
      "title": "Cached Input Tokens",
      "type": "integer"
    },
    "completed_at_utc": {
      "format": "date-time",
      "title": "Completed At Utc",
      "type": "string"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "provider_http_status": {
      "anyOf": [
        {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Http Status"
    },
    "provider_model": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Model"
    },
    "provider_request_id_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Request Id Hash"
    },
    "provider_service_tier": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Service Tier"
    },
    "reasoning_tokens": {
      "minimum": 0,
      "title": "Reasoning Tokens",
      "type": "integer"
    },
    "redacted_error_code": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Redacted Error Code"
    },
    "request_body_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Body Sha256",
      "type": "string"
    },
    "response_body_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Body Sha256"
    },
    "response_headers_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Headers Sha256"
    },
    "result_class": {
      "enum": [
        "completed",
        "refusal",
        "schema_error",
        "parse_error",
        "incomplete",
        "auth_error",
        "transport_error",
        "rate_limited",
        "server_error",
        "timeout_ambiguous",
        "local_block"
      ],
      "title": "Result Class",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schedule_ordinal": {
      "minimum": 1,
      "title": "Schedule Ordinal",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "schedule_ordinal",
    "attempt_id",
    "attempt_index",
    "completed_at_utc",
    "result_class",
    "input_tokens",
    "cached_input_tokens",
    "output_tokens",
    "reasoning_tokens",
    "latency_ms",
    "request_body_sha256"
  ],
  "title": "AttemptTerminal",
  "type": "object"
}
