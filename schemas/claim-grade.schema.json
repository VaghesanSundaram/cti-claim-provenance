{
  "$defs": {
    "EvidenceAssessment": {
      "additionalProperties": false,
      "description": "Deterministic and human-linked decisions for one cited span.",
      "properties": {
        "authority": {
          "enum": [
            "accepted",
            "weak",
            "wrong",
            "unresolved",
            "not_applicable"
          ],
          "title": "Authority",
          "type": "string"
        },
        "entailment": {
          "enum": [
            "supported",
            "partial",
            "unsupported",
            "not_applicable"
          ],
          "title": "Entailment",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "resolution": {
          "enum": [
            "resolved",
            "missing",
            "wrong_snapshot"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "span_hash_match": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Span Hash Match"
        },
        "temporality": {
          "enum": [
            "admissible",
            "post_cutoff",
            "invalid_basis",
            "not_applicable"
          ],
          "title": "Temporality",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "resolution",
        "entailment",
        "temporality",
        "authority",
        "span_hash_match"
      ],
      "title": "EvidenceAssessment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Grader-owned claim assessment, separate from generated output.",
  "properties": {
    "abstention_outcome": {
      "enum": [
        "correct",
        "unnecessary",
        "missed",
        "not_applicable"
      ],
      "title": "Abstention Outcome",
      "type": "string"
    },
    "authority_policy_version": {
      "minLength": 1,
      "title": "Authority Policy Version",
      "type": "string"
    },
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "claim_grade_id": {
      "minLength": 1,
      "title": "Claim Grade Id",
      "type": "string"
    },
    "claim_support": {
      "enum": [
        "supported",
        "unsupported",
        "contradictory",
        "ungradable"
      ],
      "title": "Claim Support",
      "type": "string"
    },
    "contradiction": {
      "enum": [
        "none",
        "lower_authority",
        "peer_authority",
        "primary_authority"
      ],
      "title": "Contradiction",
      "type": "string"
    },
    "deterministic_grader_version": {
      "minLength": 1,
      "title": "Deterministic Grader Version",
      "type": "string"
    },
    "evidence_assessments": {
      "items": {
        "$ref": "#/$defs/EvidenceAssessment"
      },
      "title": "Evidence Assessments",
      "type": "array"
    },
    "expected_claim_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expected Claim Id"
    },
    "generated_claim_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Generated Claim Id"
    },
    "generated_confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Generated Confidence"
    },
    "human_judgment_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Human Judgment Id"
    },
    "normalization_version": {
      "minLength": 1,
      "title": "Normalization Version",
      "type": "string"
    },
    "notes_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Notes Code"
    },
    "predicate": {
      "enum": [
        "cve.affected_versions",
        "directive.required_action",
        "cve.published_at",
        "cve.modified_at",
        "cve.cvss.score",
        "kev.is_member",
        "kev.date_added",
        "kev.due_date",
        "kev.ransomware_campaign_use",
        "nvd.cpe_applicability",
        "vendor.affected_versions",
        "vendor.fixed_versions",
        "vendor.recommended_action",
        "vendor.release_affected_versions",
        "vendor.security_release_versions",
        "vendor.cve_fixed_release",
        "attack.relationship_present",
        "attack.platforms",
        "source.temporal_change",
        "source.authority_divergence",
        "source.multi_source_synthesis"
      ],
      "title": "Predicate",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "value_match": {
      "enum": [
        "exact",
        "partial",
        "mismatch",
        "not_applicable"
      ],
      "title": "Value Match",
      "type": "string"
    }
  },
  "required": [
    "claim_grade_id",
    "run_id",
    "case_id",
    "generated_claim_id",
    "expected_claim_id",
    "predicate",
    "value_match",
    "evidence_assessments",
    "contradiction",
    "claim_support",
    "abstention_outcome",
    "generated_confidence",
    "deterministic_grader_version",
    "authority_policy_version",
    "normalization_version",
    "human_judgment_id",
    "notes_code"
  ],
  "title": "ClaimGrade",
  "type": "object"
}
