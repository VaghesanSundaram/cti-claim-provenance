{
  "$defs": {
    "NoProviderTransport": {
      "additionalProperties": false,
      "description": "Provider transport disabled; this class opens no connection.",
      "properties": {
        "allowed": {
          "const": false,
          "title": "Allowed",
          "type": "boolean"
        },
        "endpoint_class": {
          "const": "none",
          "title": "Endpoint Class",
          "type": "string"
        },
        "provider": {
          "const": "none",
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "allowed",
        "provider",
        "endpoint_class"
      ],
      "title": "NoProviderTransport",
      "type": "object"
    },
    "OfficialProviderTransport": {
      "additionalProperties": false,
      "description": "A named official API transport posture; this class opens no connection.",
      "properties": {
        "allowed": {
          "const": true,
          "title": "Allowed",
          "type": "boolean"
        },
        "endpoint_class": {
          "const": "official_model_api",
          "title": "Endpoint Class",
          "type": "string"
        },
        "provider": {
          "enum": [
            "openai",
            "anthropic",
            "google"
          ],
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "allowed",
        "provider",
        "endpoint_class"
      ],
      "title": "OfficialProviderTransport",
      "type": "object"
    },
    "ProviderTransport": {
      "anyOf": [
        {
          "$ref": "#/$defs/NoProviderTransport"
        },
        {
          "$ref": "#/$defs/OfficialProviderTransport"
        }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "target_kind": {
            "const": "synthetic_fixture"
          }
        },
        "required": [
          "target_kind"
        ]
      },
      "then": {
        "properties": {
          "data_classification": {
            "const": "synthetic"
          }
        },
        "required": [
          "data_classification"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "target_kind": {
            "const": "frozen_public_document"
          }
        },
        "required": [
          "target_kind"
        ]
      },
      "then": {
        "properties": {
          "data_classification": {
            "const": "public"
          }
        },
        "required": [
          "data_classification"
        ]
      }
    }
  ],
  "description": "Frozen protocol scope, never an authorization for provider egress.",
  "properties": {
    "allowed_outcomes": {
      "items": {
        "enum": [
          "identify_or_classify",
          "cite_evidence",
          "recommend_remediation",
          "propose_local_regression_test",
          "evaluate_simulated_policy_behavior"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Outcomes",
      "type": "array",
      "uniqueItems": true
    },
    "approved_by": {
      "const": "project_protocol",
      "title": "Approved By",
      "type": "string"
    },
    "authorization_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Authorization Id",
      "type": "string"
    },
    "data_classification": {
      "enum": [
        "synthetic",
        "public"
      ],
      "title": "Data Classification",
      "type": "string"
    },
    "external_or_live_target": {
      "const": false,
      "title": "External Or Live Target",
      "type": "boolean"
    },
    "owner": {
      "const": "local_project",
      "title": "Owner",
      "type": "string"
    },
    "prohibited_outcomes": {
      "items": {
        "enum": [
          "credential_collection",
          "persistence",
          "evasion_or_stealth",
          "malware_or_phishing",
          "data_exfiltration",
          "destructive_action",
          "denial_of_service",
          "live_target_scanning_or_exploitation"
        ],
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 8,
      "title": "Prohibited Outcomes",
      "type": "array",
      "uniqueItems": true
    },
    "project": {
      "enum": [
        "cross_tool_authz",
        "cti_provenance"
      ],
      "title": "Project",
      "type": "string"
    },
    "protocol_version": {
      "const": "provider-safety-v1",
      "title": "Protocol Version",
      "type": "string"
    },
    "provider_transport": {
      "$ref": "#/$defs/ProviderTransport"
    },
    "purpose": {
      "const": "defensive_evaluation",
      "title": "Purpose",
      "type": "string"
    },
    "target_ids": {
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "minItems": 1,
      "title": "Target Ids",
      "type": "array",
      "uniqueItems": true
    },
    "target_kind": {
      "enum": [
        "synthetic_fixture",
        "frozen_public_document"
      ],
      "title": "Target Kind",
      "type": "string"
    },
    "target_network_access": {
      "const": false,
      "title": "Target Network Access",
      "type": "boolean"
    }
  },
  "required": [
    "authorization_id",
    "project",
    "purpose",
    "owner",
    "target_kind",
    "target_ids",
    "target_network_access",
    "provider_transport",
    "external_or_live_target",
    "data_classification",
    "allowed_outcomes",
    "prohibited_outcomes",
    "approved_by",
    "protocol_version"
  ],
  "title": "AuthorizationManifest",
  "type": "object"
}
