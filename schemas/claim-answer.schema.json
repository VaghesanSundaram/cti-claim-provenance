{
  "$defs": {
    "AtomicClaim": {
      "additionalProperties": false,
      "description": "Generated atomic claim; it contains no grader-owned decisions.",
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[^:\\s]+:[^:\\s]+$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "object": {
          "$ref": "#/$defs/ClaimObject"
        },
        "predicate": {
          "enum": [
            "cve.affected_versions",
            "directive.required_action",
            "cve.published_at",
            "cve.modified_at",
            "cve.cvss.score",
            "kev.is_member",
            "kev.date_added",
            "kev.due_date",
            "kev.ransomware_campaign_use",
            "nvd.cpe_applicability",
            "vendor.affected_versions",
            "vendor.fixed_versions",
            "vendor.recommended_action",
            "vendor.release_affected_versions",
            "vendor.security_release_versions",
            "vendor.cve_fixed_release",
            "attack.relationship_present",
            "attack.platforms",
            "source.temporal_change",
            "source.authority_divergence",
            "source.multi_source_synthesis"
          ],
          "title": "Predicate",
          "type": "string"
        },
        "qualifiers": {
          "$ref": "#/$defs/ClaimQualifiers"
        },
        "subject": {
          "$ref": "#/$defs/ClaimSubject"
        }
      },
      "required": [
        "claim_id",
        "subject",
        "predicate",
        "object",
        "qualifiers",
        "evidence_ids",
        "confidence"
      ],
      "title": "AtomicClaim",
      "type": "object"
    },
    "ClaimObject": {
      "additionalProperties": false,
      "description": "Typed claim value.\n\nDatatype/value consistency is enforced locally because JSON Schema cannot\nsafely infer a discriminator from two sibling properties.",
      "properties": {
        "datatype": {
          "enum": [
            "boolean",
            "string",
            "date",
            "decimal",
            "version_set",
            "identifier_set"
          ],
          "title": "Datatype",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ClaimValue"
        }
      },
      "required": [
        "value",
        "datatype"
      ],
      "title": "ClaimObject",
      "type": "object"
    },
    "ClaimQualifiers": {
      "additionalProperties": false,
      "description": "Frozen qualifier vocabulary used by the first benchmark version.",
      "properties": {
        "authority": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Authority"
        },
        "cvss_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cvss Version"
        },
        "ecosystem": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ecosystem"
        },
        "product": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Product"
        }
      },
      "required": [
        "authority",
        "cvss_version",
        "product",
        "ecosystem"
      ],
      "title": "ClaimQualifiers",
      "type": "object"
    },
    "ClaimScalar": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ]
    },
    "ClaimSubject": {
      "additionalProperties": false,
      "description": "Typed claim subject.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "cve",
            "product",
            "advisory",
            "attack_object"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "ClaimSubject",
      "type": "object"
    },
    "ClaimValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClaimScalar"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "Provider-facing answer shared by direct and citation-prompted conditions.\n\nEmpty evidence lists are valid here. The direct condition treats citation\nmetrics as not applicable; citation-prompted grading treats an empty list as\nunsupported without invalidating the rest of an otherwise valid envelope.",
  "properties": {
    "abstained": {
      "title": "Abstained",
      "type": "boolean"
    },
    "abstention_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Abstention Reason"
    },
    "answer_id": {
      "minLength": 1,
      "title": "Answer Id",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/AtomicClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "narrative": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Narrative"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "answer_id",
    "run_id",
    "case_id",
    "as_of",
    "claims",
    "abstained",
    "abstention_reason",
    "narrative"
  ],
  "title": "ClaimAnswer",
  "type": "object"
}
