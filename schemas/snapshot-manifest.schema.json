{
  "additionalProperties": false,
  "description": "Provenance record for one immutable raw snapshot.",
  "properties": {
    "available_by_basis": {
      "enum": [
        "observed_retrieval",
        "upstream_version",
        "signed_release",
        "publisher_timestamp_with_observation",
        "publisher_declared_version",
        "synthetic_fixture"
      ],
      "title": "Available By Basis",
      "type": "string"
    },
    "available_by_utc": {
      "format": "date-time",
      "title": "Available By Utc",
      "type": "string"
    },
    "byte_length": {
      "minimum": 0,
      "title": "Byte Length",
      "type": "integer"
    },
    "effective_date_basis": {
      "enum": [
        "publisher_version",
        "signed_release",
        "field",
        "unknown"
      ],
      "title": "Effective Date Basis",
      "type": "string"
    },
    "effective_date_if_known": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Effective Date If Known"
    },
    "fetcher_version": {
      "minLength": 1,
      "title": "Fetcher Version",
      "type": "string"
    },
    "http_etag": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Http Etag"
    },
    "http_last_modified": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Http Last Modified"
    },
    "http_status": {
      "const": 200,
      "title": "Http Status",
      "type": "integer"
    },
    "license_or_terms_note": {
      "minLength": 1,
      "title": "License Or Terms Note",
      "type": "string"
    },
    "media_type": {
      "minLength": 1,
      "title": "Media Type",
      "type": "string"
    },
    "normalization_version": {
      "minLength": 1,
      "title": "Normalization Version",
      "type": "string"
    },
    "raw_blob_path": {
      "minLength": 1,
      "title": "Raw Blob Path",
      "type": "string"
    },
    "retrieved_at_utc": {
      "format": "date-time",
      "title": "Retrieved At Utc",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_class": {
      "enum": [
        "government",
        "standards_body",
        "vendor",
        "synthetic"
      ],
      "title": "Source Class",
      "type": "string"
    },
    "source_name": {
      "enum": [
        "cisa_directive",
        "cve_program",
        "nvd",
        "cisa_kev",
        "mitre_attack",
        "netscaler_advisory",
        "red_hat_rhsa",
        "synthetic_control",
        "vendor_advisory"
      ],
      "title": "Source Name",
      "type": "string"
    },
    "source_url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "pattern": "^urn:",
          "type": "string"
        }
      ],
      "title": "Source Url"
    },
    "upstream_identifier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Upstream Identifier"
    },
    "upstream_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Upstream Version"
    }
  },
  "required": [
    "snapshot_id",
    "source_name",
    "source_class",
    "source_url",
    "retrieved_at_utc",
    "http_status",
    "http_etag",
    "http_last_modified",
    "effective_date_if_known",
    "effective_date_basis",
    "available_by_utc",
    "available_by_basis",
    "upstream_identifier",
    "upstream_version",
    "media_type",
    "byte_length",
    "sha256",
    "raw_blob_path",
    "fetcher_version",
    "normalization_version",
    "license_or_terms_note"
  ],
  "title": "SnapshotManifest",
  "type": "object"
}
