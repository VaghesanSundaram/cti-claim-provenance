{
  "additionalProperties": false,
  "description": "One redacted safety classification for every actual provider attempt.",
  "properties": {
    "approval_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approval Hash",
      "type": "string"
    },
    "approval_id": {
      "minLength": 1,
      "title": "Approval Id",
      "type": "string"
    },
    "approved_at_utc": {
      "format": "date-time",
      "title": "Approved At Utc",
      "type": "string"
    },
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "attempt_index": {
      "maximum": 2,
      "minimum": 1,
      "title": "Attempt Index",
      "type": "integer"
    },
    "authorization_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Authorization Hash",
      "type": "string"
    },
    "authorization_id": {
      "minLength": 1,
      "title": "Authorization Id",
      "type": "string"
    },
    "authorization_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Authorization Ids",
      "type": "array"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "provider": {
      "const": "openai",
      "title": "Provider",
      "type": "string"
    },
    "provider_request_id_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Request Id Hash"
    },
    "recorded_at_utc": {
      "format": "date-time",
      "title": "Recorded At Utc",
      "type": "string"
    },
    "request_template_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Template Hash",
      "type": "string"
    },
    "request_template_version": {
      "minLength": 1,
      "title": "Request Template Version",
      "type": "string"
    },
    "response_used_for_scoring": {
      "title": "Response Used For Scoring",
      "type": "boolean"
    },
    "retry_count": {
      "maximum": 1,
      "minimum": 0,
      "title": "Retry Count",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "safety_outcome": {
      "enum": [
        "allowed",
        "refused",
        "additional_check",
        "blocked",
        "unknown"
      ],
      "title": "Safety Outcome",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schedule_ordinal": {
      "minimum": 1,
      "title": "Schedule Ordinal",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "scenario_id",
    "schedule_ordinal",
    "attempt_id",
    "attempt_index",
    "recorded_at_utc",
    "authorization_id",
    "authorization_ids",
    "authorization_hash",
    "approval_id",
    "approved_at_utc",
    "approval_hash",
    "provider",
    "model",
    "request_template_version",
    "request_template_hash",
    "safety_outcome",
    "retry_count",
    "response_used_for_scoring"
  ],
  "title": "SafetyEvent",
  "type": "object"
}
