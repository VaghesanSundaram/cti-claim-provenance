{
  "additionalProperties": false,
  "description": "Actual known cost for a terminal attempt, bounded by its reservation.",
  "properties": {
    "actual_cost_usd": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,4}|(?=[\\d.]{1,13}0*$)\\d{0,4}\\.\\d{0,8}0*$)",
      "title": "Actual Cost Usd",
      "type": "string"
    },
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "attempt_index": {
      "maximum": 2,
      "minimum": 1,
      "title": "Attempt Index",
      "type": "integer"
    },
    "cost_basis": {
      "enum": [
        "provider_usage_estimate",
        "known_zero",
        "ambiguous_reserved_max"
      ],
      "title": "Cost Basis",
      "type": "string"
    },
    "pricing_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pricing Hash",
      "type": "string"
    },
    "reconciled_at_utc": {
      "format": "date-time",
      "title": "Reconciled At Utc",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schedule_ordinal": {
      "minimum": 1,
      "title": "Schedule Ordinal",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "schedule_ordinal",
    "attempt_id",
    "attempt_index",
    "reconciled_at_utc",
    "actual_cost_usd",
    "cost_basis",
    "pricing_hash"
  ],
  "title": "CostReconciliation",
  "type": "object"
}
